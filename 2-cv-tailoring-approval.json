        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Yahan mera base resume hai:\\n\\n[SUMMARY: Computer Engineering graduate, AI Engineer Intern at OptimusFox, n8n automation, LLM APIs]\\n[SKILLS: n8n, LLM APIs, PHP, Laravel, JavaScript, YOLO, EasyOCR, Networking, Docker, PostgreSQL]\\n[PROJECTS: Multi-Platform Social Media Automation (n8n), AI Accident Response System (YOLO/EasyOCR/Streamlit)]\\n\\nJob Title: {{ $json.Title }}\\nCompany: {{ $json.Company }}\\nJob Description: {{ $json.description }}\\n\\nDo cheezein karo:\\n1. Ek ATS-optimized 3-4 line summary aur 6-8 relevant skills banao jo IS job se match karein.\\n2. Job description scan karo aur batao kya extra documents mangey gaye hain (transcript, cover letter, portfolio, certificates, references) \\u2014 agar kuch na mile to empty array do.\\n\\nSirf JSON format main jawab do: {\\\"summary\\\": \\\"...\\\", \\\"skills\\\": [\\\"...\\\"], \\\"extraRequirements\\\": [\\\"...\\\"]}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {
