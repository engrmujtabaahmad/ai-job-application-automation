      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst html = `\n<html><head><style>\nbody { font-family: Arial, sans-serif; padding: 40px; color: #222; }\nh1 { color: #1F3864; margin-bottom: 0; }\nh2 { color: #1F3864; border-bottom: 1px solid #1F3864; padding-bottom: 4px; margin-top: 20px; }\n.contact { font-size: 13px; color: #444; }\nul { margin: 5px 0; padding-left: 20px; }\n</style></head><body>\n<h1>MUHAMMAD MUJTABA AHMAD</h1>\n<div class=\"contact\">YOUR_CITY, YOUR_COUNTRY | YOUR_PHONE | YOUR_EMAIL<br>\nlinkedin.com/in/muhammad-mujtaba-ahmad-29a3b7360 | github.com/engrmujtabaahmad</div>\n\n<h2>PROFESSIONAL SUMMARY</h2>\n<p>${data.tailoredSummary}</p>\n\n<h2>SKILLS</h2>\n<ul>${data.tailoredSkills.map(s => `<li>${s}</li>`).join('')}</ul>\n\n<h2>EXPERIENCE</h2>\n<p><b>AI Engineer Intern</b> \\u2014 OptimusFox Pvt Ltd (Jul 2026 \\u2013 Present)</p>\n<p><b>System Support Engineer</b> \\u2014 Sybrid (Pvt) Ltd (Jun 2026 \\u2013 Aug 2026)</p>\n<p><b>IT Intern</b> \\u2014 Fauji Fertilizer Company (Jul 2025 \\u2013 Sep 2025)</p>\n\n<h2>EDUCATION</h2>\n<p>BS Computer Engineering \\u2014 KFUEIT, Rahim Yar Khan (CGPA: 3.88/4.0)</p>\n\n<h2>APPLYING FOR</h2>\n<p>${data.Title} at ${data.Company}</p>\n</body></html>\n`;\n\nreturn [{ json: { ...data, resumeHtml: html } }];"
      },
