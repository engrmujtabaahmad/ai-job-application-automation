    {
      "parameters": {
        "jsCode": "const subject = $json.Subject || $json.subject || \"\";\nconst body = ($json.text || $json.snippet || \"\").toLowerCase();\nconst rowMatch = subject.match(/\\[ROW:(\\d+)\\]/);\nconst rowNumber = rowMatch ? parseInt(rowMatch[1]) : null;\nconst approved = body.includes(\"approve\") && !body.includes(\"skip\");\n\nreturn [{ json: { rowNumber, approved, subject } }];"
      },
      "type": "n8n-nodes-base.code",
