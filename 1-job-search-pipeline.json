    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/actors/truefetch~job-search/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"keyword\": \"AI Engineer\",\n  \"country\": \"Pakistan\",\n  \"max_results\": 25\n}",
        "options": {}
