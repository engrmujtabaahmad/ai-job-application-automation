      "id": "9a3d889b-0a0a-49ac-8088-a8211bdabe04",
      "name": "Apify"
    },
    {
      "parameters": {
        "url": "https://api.adzuna.com/v1/api/jobs/gb/search/1?results_per_page=25&what=AI%20Engineer&content-type=application/json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -368,
        -112
      ],
      "id": "5f872751-bc6b-4213-b18c-7bb2a3482105",
      "name": "Adzuna"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const d = item.json;\n\n  // Adzuna shape: has \"results\" array\n  if (d.results && Array.isArray(d.results)) {\n    for (const job of d.results) {\n      output.push({\n        json: {\n          title: job.title,\n          company: job.company?.display_name || \"Unknown\",\n          location: job.location?.display_name || \"\",\n          platform: \"Adzuna\",\n          description: job.description,\n          applyUrl: job.redirect_url,\n          postedDate: job.created,\n          salaryMin: job.salary_min || null,\n          salaryMax: job.salary_max || null\n        }\n      });\n    }\n  }\n  // Apify shape: already flat job objects\n  else if (d.job_title || d.title) {\n    output.push({\n      json: {\n        title: d.job_title || d.title,\n        company: d.company_name || \"Unknown\",\n        location: d.location || \"\",\n        platform: d.platform || \"Unknown\",\n        description: d.description || \"\",\n        applyUrl: d.official_url || d.platform_url || \"\",\n        postedDate: d.posted_date || \"\",\n        salaryMin: d.salary_minimum || null,\n        salaryMax: d.salary_maximum || null\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
        -64
      ],
      "id": "3d19c258-2f5e-4cd4-8336-69ca74840b1e",
      "name": "Normalize"
    },
    {
      "parameters": {
