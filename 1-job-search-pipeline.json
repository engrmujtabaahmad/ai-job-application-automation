      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        -368,
        256
      ],
      "id": "3b0312e2-9dea-4710-a018-1b92f92da75b",
      "name": "Get Existing Applications"
    },
    {
      "parameters": {
        "jsCode": "const keywords = [\"ai\", \"machine learning\", \"software engineer\", \"web developer\", \"laravel\", \"automation\"];\n\nreturn $input.all().filter(item => {\n  const title = (item.json.title || \"\").toLowerCase();\n  return keywords.some(k => title.includes(k));\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        -16
      ],
      "id": "8cf16030-4fc3-450b-935b-8a251de4cdb0",
      "name": "keyword filter"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst norm = (s) => (s || \"\").toString().toLowerCase().trim().replace(/\\s+/g, \" \");\n\n// Existing rows from the Sheet - build a key from title + company\nconst existingKeys = new Set(\n  items\n    .filter(i => i.json['Apply URL'] !== undefined)\n    .map(i => `${norm(i.json.Title)}|${norm(i.json.Company)}`)\n);\n\n// New search results\nconst jobItems = items.filter(i => i.json.applyUrl !== undefined);\n\nreturn jobItems.filter(i => {\n  const key = `${norm(i.json.title)}|${norm(i.json.company)}`;\n  return !existingKeys.has(key);\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        -16
      ],
      "id": "002b3587-b0eb-4d04-acaf-36934f7c77b7",
      "name": "Dedup Check"
    }
